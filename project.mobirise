    "index.html": {
      "settings": {
        "main": true,
        "title": "Pump Swap™ | swap.pump.fun | Home Official Site",
        "meta_descr": "Pump lets anyone create coins, giving everyone equal access to buy and sell from the start. Prices can move quickly, so trade carefully. Continue.",
